{
  "rewrites": [
    { "source": "/(i|l|m)/:id", "destination": "/index.html" },
    { "source": "/:path((?!assets|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
